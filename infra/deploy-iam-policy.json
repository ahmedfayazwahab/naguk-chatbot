{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CdkBootstrapAndCloudFormation",
      "Effect": "Allow",
      "Action": [
        "cloudformation:*",
        "s3:*",
        "ecr:*",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:PutParameter",
        "ssm:DeleteParameter",
        "sts:GetCallerIdentity",
        "sts:AssumeRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AppResources",
      "Effect": "Allow",
      "Action": [
        "lambda:*",
        "apigateway:*",
        "dynamodb:*",
        "secretsmanager:*",
        "logs:*",
        "budgets:*",
        "tag:GetResources",
        "resource-groups:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IamForLambdaExecutionRoles",
      "Effect": "Allow",
      "Action": [
        "iam:Get*",
        "iam:List*",
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:UpdateRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:PassRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:TagPolicy"
      ],
      "Resource": "*"
    }
  ]
}
